# Django
SECRET_KEY=change-me-to-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (sqlite — works on any PC, no extra install)
DB_ENGINE=sqlite

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis (optional)
USE_REDIS=False

# Demo mode
DEMO_MODE=True
DEMO_TRACKING=True
FRONTEND_URL=http://localhost:5173
# Production (Render + Vercel) — current live hosts:
# FRONTEND_URL=https://kaamsetu.app
# PUBLIC_FRONTEND_URL=https://kaamsetu.app
# ALLOWED_HOSTS=kaamsetu-api-vtac.onrender.com,kaamsetu-api.onrender.com,.onrender.com
# CORS_ALLOWED_ORIGINS=https://kaamsetu.app,https://www.kaamsetu.app
# CSRF_TRUSTED_ORIGINS=https://kaamsetu.app,https://www.kaamsetu.app
# API base used by Vercel rewrite: https://kaamsetu-api-vtac.onrender.com/api
# Do not use api.kaamsetu.app until that custom domain is configured on Render + DNS.
# Auto local tunnel: run-dev.ps1 → .tunnel-url (WiFi + mobile data)

# Email — real OTP to inbox (Gmail: use App Password, not account password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your@gmail.com
EMAIL_VERIFICATION_REQUIRED=False
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5

# Console-only fallback (OTP prints in terminal, no real mail):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=

# Firebase — must match frontend VITE_FIREBASE_PROJECT_ID and service account JSON
# Current KaamSetu Firebase project (local service account + frontend/.env):
FIREBASE_PROJECT_ID=kaamsetu-a51c6
# Relative path — works on F:\, D:\, C:\ any folder
FIREBASE_CREDENTIALS_PATH=backend/firebase-service-account.json
# Render/production alternative (paste full JSON from Firebase Console; do not commit):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"kaamsetu-a51c6",...}

# AI Diagnosis (Google Gemini Free Tier - get key from https://aistudio.google.com)
GEMINI_API_KEY=
# Or OpenAI:
# OPENAI_API_KEY=
# AI_ENABLED=True

# Google OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=

# Media uploads (local disk — default)
# Files stored under backend/media/ and served at /media/ when SERVE_MEDIA_FROM_DISK=True.
# Render free tier: filesystem is EPHEMERAL — uploads are lost on redeploy/restart.
# For persistent production media, configure S3-compatible storage manually (not included by default):
#   SERVE_MEDIA_FROM_DISK=False
#   AWS_STORAGE_BUCKET_NAME=
#   AWS_S3_REGION_NAME=
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#   AWS_S3_CUSTOM_DOMAIN=   (optional CDN domain)
# Then install/configure django-storages separately.
SERVE_MEDIA_FROM_DISK=True

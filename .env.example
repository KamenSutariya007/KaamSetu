# Django
SECRET_KEY=change-me-to-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (sqlite — works on any PC, no extra install)
DB_ENGINE=sqlite

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis (optional)
USE_REDIS=False

# Demo mode
DEMO_MODE=True
DEMO_TRACKING=True
FRONTEND_URL=http://localhost:5173
# Production (Render + Vercel):
# FRONTEND_URL=https://kaamsetu.app
# PUBLIC_FRONTEND_URL=https://kaamsetu.app
# ALLOWED_HOSTS=api.kaamsetu.app,.onrender.com
# CORS_ALLOWED_ORIGINS=https://kaamsetu.app,https://www.kaamsetu.app
# Auto local tunnel: run-dev.ps1 → .tunnel-url (WiFi + mobile data)

# Email — real OTP to inbox (Gmail: use App Password, not account password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your@gmail.com
EMAIL_VERIFICATION_REQUIRED=False
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=5

# Console-only fallback (OTP prints in terminal, no real mail):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=

# Firebase — same project on every PC (cloud; no reinstall needed)
FIREBASE_PROJECT_ID=kaamsetu-ef0d3
# Relative path — works on F:\, D:\, C:\ any folder
FIREBASE_CREDENTIALS_PATH=backend/firebase-service-account.json

# Google OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=

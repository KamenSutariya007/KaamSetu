# API URL — leave unset for local (Vite proxies /api → http://127.0.0.1:8000).

# Production (Vercel): leave unset so the app calls same-origin /api

# (rewritten in vercel.json to https://kaamsetu-api-vtac.onrender.com/api).

# Direct (optional): VITE_API_URL=https://kaamsetu-api-vtac.onrender.com/api

# Do not use https://api.kaamsetu.app until that custom domain is live.

# VITE_API_URL=



# Firebase — OFF by default. Must match backend service account project_id.

# Copy web app values from Firebase Console → Project settings → Your apps.

VITE_USE_FIREBASE=false

VITE_FIREBASE_API_KEY=your-web-api-key

VITE_FIREBASE_AUTH_DOMAIN=kaamsetu-a51c6.firebaseapp.com

VITE_FIREBASE_PROJECT_ID=kaamsetu-a51c6

VITE_FIREBASE_STORAGE_BUCKET=kaamsetu-a51c6.firebasestorage.app

VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

VITE_FIREBASE_APP_ID=your-app-id

VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id



# Google OAuth (optional)

VITE_GOOGLE_CLIENT_ID=


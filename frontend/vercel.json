{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/((?!send-mail$).*)",
      "destination": "https://kaamsetu-api-vtac.onrender.com/api/$1"
    },
    {
      "source": "/media/:path*",
      "destination": "https://kaamsetu-api-vtac.onrender.com/media/:path*"
    },
    {
      "source": "/((?!assets/|api/send-mail).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.kaamsetu.app" }],
      "destination": "https://kaamsetu.app/:path*",
      "permanent": true
    }
  ]
}
